# Optional server-side AI settings for Canopy. Copy to .dev.vars for local development
# (Wrangler reads it) or set the same names as encrypted secrets in Cloudflare Pages.
# Never commit real keys. Without AI_API_KEY, Canopy answers from its offline knowledge base.

# Secret: API key for an OpenAI-compatible chat-completions service.
AI_API_KEY=

# Optional: base URL of that service (default: https://api.openai.com/v1).
AI_BASE_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-4o-mini).
AI_MODEL=gpt-4o-mini
